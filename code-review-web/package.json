{
  "name": "code-review-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "format": "prettier --write \"src/**/*.{js,jsx}\" \"*.config.js\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\" \"*.config.js\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "vitest": "latest",
    "@vitest/coverage-v8": "latest",
    "jsdom": "latest",
    "@testing-library/react": "latest",
    "prettier": "latest"
  }
}
